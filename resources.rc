// TinyNext 应用资源：图标 + 版本信息（Windows）
1 ICON "assets/icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     0,2,0,0
 PRODUCTVERSION  0,2,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x00040004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName",      "TinyNext"
      VALUE "FileDescription",  "TinyNext 下载器"
      VALUE "FileVersion",      "0.2.0"
      VALUE "ProductName",      "TinyNext 下载器"
      VALUE "ProductVersion",   "0.2.0"
      VALUE "InternalName",     "tinynext"
      VALUE "OriginalFilename", "tinynext.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
