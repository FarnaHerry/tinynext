{
  "manifest_version": 3,
  "name": "TinyNext 下载器",
  "version": "0.1.0",
  "description": "把网页链接与浏览器下载转发给 TinyNext 下载器（aria2-next 引擎）。",
  "key": "",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TinyNext 下载器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "downloads", "nativeMessaging", "storage"]
}
