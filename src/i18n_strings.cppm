// i18n_strings.cppm — UI 翻译表（简中 / 繁中 / 英语）。
//
// 全量一等公民派（Android 风格）：所有语言（含默认简中）都进表，调用点用短语义键
// 查表，查不到回退 zhCN，再查不到回退键本身。表是编译期常量数组，tr() 零运行时文件
// IO、零分配（返回指向本表条目的 string_view，生命期永久）。
//
// 键命名：点分命名空间（ns.key），稳定不变、与文案解耦，便于今后加语种。
// 繁体由 OpenCC(s2twp) 词级转换后针对台湾用语审校（軟體/影片/網路/伺服器/檔案/
// 連線/連接埠/設定/預設/資源回收筒 等），无运行时 OpenCC 依赖。
export module tinynext.i18n_strings;

import std;

namespace i18n {

// 单条翻译：键 + 三语文案。zhCN 同时是回退基准；zhTw/en 查不到时回退 zhCN。
export struct Entry {
    std::string_view key;
    std::string_view zhCN;
    std::string_view zhTW;
    std::string_view en;
};

// 全部文案条目。按命名空间分组、组内按出现顺序，方便审校与去重。
// 注意：每个键在本数组中唯一；多个调用点共享同一键（见 i18n.cppm 的 doc）。
